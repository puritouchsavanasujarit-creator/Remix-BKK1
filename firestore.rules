rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrder(data) {
      return data is map
        && data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 64
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 128
        && data.productName is string && data.productName.size() > 0 && data.productName.size() <= 128
        && data.deliveryAddress is string && data.deliveryAddress.size() <= 500
        && (!('orderTime' in data) || (data.orderTime is string && data.orderTime.size() <= 32))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 32))
        && (!('productPrice' in data) || data.productPrice is number)
        && (!('deliveryFee' in data) || data.deliveryFee is number)
        && (!('totalPrice' in data) || data.totalPrice is number)
        && (!('distanceKm' in data) || data.distanceKm is number)
        && (!('cardMessage' in data) || (data.cardMessage is string && data.cardMessage.size() <= 1000))
        && (!('specialInstructions' in data) || (data.specialInstructions is string && data.specialInstructions.size() <= 1000))
        && (!('opNotes' in data) || (data.opNotes is string && data.opNotes.size() <= 1000));
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if isSignedIn() && isValidId(orderId);
    }
  }
}
